{
  "name": "nota-ai-commit-lainbo",
  "displayName": "Nota AI Commit",
  "version": "0.1.21",
  "description": "Use Azure/OpenAI/Gemini API to review Git changes, generate conventional commit messages that meet the conventions, simplify the commit process, and keep the commit conventions consistent.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "AI Commit",
    "Auto Commit",
    "Azure",
    "ChatGPT",
    "Commit Message",
    "Commit Message Generator",
    "Commitizen",
    "Conventional Commits",
    "Gemini",
    "Git Commit",
    "GitEmoji",
    "OpenAI"
  ],
  "license": "MIT",
  "repository": "https://github.com/lainbo/ai-commit",
  "publisher": "lainbo",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.js",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "vscode:prepublish": "npm run build",
    "watch": "node esbuild.js --watch"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "extension.ai-commit",
        "icon": "images/logo1.svg",
        "title": "%aiCommit.command.aiCommit.title%"
      },
      {
        "command": "ai-commit.showAvailableModels",
        "title": "%aiCommit.command.showAvailableModels.title%"
      },
      {
        "command": "ai-commit.setOpenAIApiKey",
        "title": "%aiCommit.command.setOpenAIApiKey.title%"
      },
      {
        "command": "ai-commit.setGeminiApiKey",
        "title": "%aiCommit.command.setGeminiApiKey.title%"
      },
      {
        "command": "ai-commit.clearOpenAIApiKey",
        "title": "%aiCommit.command.clearOpenAIApiKey.title%"
      },
      {
        "command": "ai-commit.clearGeminiApiKey",
        "title": "%aiCommit.command.clearGeminiApiKey.title%"
      }
    ],
    "submenus": [
      {
        "id": "ai-commit.apiKeyMenu",
        "label": "%aiCommit.menu.apiKeys.label%"
      }
    ],
    "configuration": [
      {
        "title": "%aiCommit.configuration.general.title%",
        "properties": {
          "ai-commit.AI_PROVIDER": {
            "type": "string",
            "default": "openai",
            "description": "%aiCommit.config.aiProvider.description%",
            "enum": [
              "openai",
              "gemini"
            ]
          },
          "ai-commit.DIFF_SOURCE": {
            "type": "string",
            "default": "auto",
            "enum": [
              "auto",
              "staged",
              "unstaged",
              "staged+unstaged"
            ],
            "description": "%aiCommit.config.diffSource.description%"
          },
          "ai-commit.AI_COMMIT_LANGUAGE": {
            "default": "English",
            "description": "%aiCommit.config.commitLanguage.description%",
            "enum": [
              "Simplified Chinese",
              "Traditional Chinese",
              "Japanese",
              "Korean",
              "Czech",
              "German",
              "French",
              "Italian",
              "Dutch",
              "Portuguese",
              "Vietnamese",
              "English",
              "Spanish",
              "Swedish",
              "Russian",
              "Bahasa",
              "Polish",
              "Turkish",
              "Thai"
            ],
            "enumDescriptions": [
              "简体中文",
              "繁體中文",
              "にほんご",
              "한국어",
              "česky",
              "Deutsch",
              "française",
              "italiano",
              "Nederlands",
              "português",
              "tiếng Việt",
              "english",
              "español",
              "Svenska",
              "русский",
              "bahasa",
              "Polski",
              "Turkish",
              "ไทย"
            ],
            "type": "string"
          },
          "ai-commit.AI_COMMIT_SYSTEM_PROMPT": {
            "type": "string",
            "default": "",
            "description": "%aiCommit.config.systemPrompt.description%"
          },
          "ai-commit.SCM_INPUT_BEHAVIOR": {
            "type": "string",
            "default": "ignore",
            "enum": [
              "ignore",
              "context"
            ],
            "enumDescriptions": [
              "%aiCommit.config.scmInputBehavior.enum.ignore%",
              "%aiCommit.config.scmInputBehavior.enum.context%"
            ],
            "description": "%aiCommit.config.scmInputBehavior.description%"
          }
        }
      },
      {
        "title": "%aiCommit.configuration.git.title%",
        "properties": {
          "ai-commit.REFERENCE_GIT_LOG": {
            "type": "boolean",
            "default": true,
            "description": "%aiCommit.config.referenceGitLog.description%"
          },
          "ai-commit.GIT_LOG_COUNT": {
            "type": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 50,
            "description": "%aiCommit.config.gitLogCount.description%"
          },
          "ai-commit.GIT_LOG_AUTHOR_SCOPE": {
            "type": "string",
            "default": "all",
            "enum": [
              "all",
              "self"
            ],
            "enumDescriptions": [
              "%aiCommit.config.gitLogAuthorScope.enum.all%",
              "%aiCommit.config.gitLogAuthorScope.enum.self%"
            ],
            "description": "%aiCommit.config.gitLogAuthorScope.description%"
          }
        }
      },
      {
        "title": "%aiCommit.configuration.openai.title%",
        "properties": {
          "ai-commit.OPENAI_BASE_URL": {
            "default": "https://api.openai.com/v1",
            "markdownDescription": "%aiCommit.config.openaiBaseUrl.description%",
            "type": "string"
          },
          "ai-commit.AZURE_API_VERSION": {
            "default": "",
            "description": "%aiCommit.config.azureApiVersion.description%",
            "type": "string"
          },
          "ai-commit.OPENAI_MODEL": {
            "default": "gpt-5-mini",
            "description": "%aiCommit.config.openaiModel.description%",
            "type": "string"
          },
          "ai-commit.OPENAI_TEMPERATURE": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "description": "%aiCommit.config.openaiTemperature.description%"
          }
        }
      },
      {
        "title": "%aiCommit.configuration.gemini.title%",
        "properties": {
          "ai-commit.GEMINI_BASE_URL": {
            "type": "string",
            "default": "https://generativelanguage.googleapis.com",
            "markdownDescription": "%aiCommit.config.geminiBaseUrl.description%"
          },
          "ai-commit.GEMINI_MODEL": {
            "type": "string",
            "default": "gemini-3.8-flash",
            "description": "%aiCommit.config.geminiModel.description%"
          },
          "ai-commit.GEMINI_TEMPERATURE": {
            "type": "number",
            "default": 0.7,
            "minimum": 0,
            "maximum": 2,
            "description": "%aiCommit.config.geminiTemperature.description%"
          }
        }
      }
    ],
    "menus": {
      "extension/context": [
        {
          "submenu": "ai-commit.apiKeyMenu",
          "when": "extension == lainbo.nota-ai-commit-lainbo",
          "group": "2_configure"
        }
      ],
      "ai-commit.apiKeyMenu": [
        {
          "command": "ai-commit.setOpenAIApiKey",
          "group": "1_set@1"
        },
        {
          "command": "ai-commit.setGeminiApiKey",
          "group": "1_set@2"
        }
      ],
      "scm/title": [
        {
          "command": "extension.ai-commit",
          "group": "navigation"
        }
      ]
    }
  },
  "icon": "images/logo.png",
  "engines": {
    "node": ">=20",
    "vscode": "^1.96.0"
  }
}
